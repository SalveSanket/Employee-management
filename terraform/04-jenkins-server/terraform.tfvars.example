# Optional: copy to terraform.tfvars (ignored by Git) and change values.
#   cp terraform.tfvars.example terraform.tfvars
# Every value below is optional; the defaults are shown.

# aws_region            = "ap-south-1"
# project               = "emp"
# instance_type         = "t3.small"
# root_volume_size      = 20
# timezone              = "Asia/Kolkata"
# java_major_version    = 21
# node_major_version    = 22
# jenkins_port          = 8080
# ansible_server_name   = "ansible"

# Allow GitHub webhooks (push -> automatic build)
# allow_github_webhooks = true

# SSH and Jenkins UI allowed from: null = your current IP, detected automatically
# admin_cidr = "203.0.113.10/32"
