# ==============================================================
# Employee Management System - Git ignore rules
# Keeps secrets, generated files and local-only files out of Git
# ==============================================================

# ---------- Secrets and credentials (never commit) ----------
*.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.ppk
id_rsa*
id_ed25519*
credentials*
secrets*

# ---------- Dependencies ----------
node_modules/
.npm/
.pnpm-store/

# ---------- Build output ----------
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
.vite/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Terraform ----------
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ---------- Ansible ----------
*.retry
.vault_pass*

# ---------- Local project notes (not part of the project) ----------
docs/
*.pdf

# ---------- Editor and AI tool settings ----------
.vscode/
.idea/
.kiro/
*.swp
*.swo
*~

# ---------- Operating system files ----------
.DS_Store
._*
Thumbs.db
desktop.ini
